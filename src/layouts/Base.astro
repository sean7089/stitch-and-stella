---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import hero from '../assets/hero-porch.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  showOrderBar?: boolean;
}

const {
  title,
  description,
  image = hero,
  jsonLd,
  noindex = false,
  showOrderBar = true,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site ?? 'https://www.stitchandstella.com');
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 68 });
const ogUrl = new URL(og.src, Astro.site ?? 'https://www.stitchandstella.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#fff7f8" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site guide for assistants" />
    <link rel="alternate" type="application/json" href="/data/catalog.json" title="Bandana catalog" />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body class:list={['bg-blush-50 text-ink antialiased', showOrderBar && 'pb-24 md:pb-0']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header pathname={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      showOrderBar && (
        <div class="fixed inset-x-0 bottom-0 z-40 border-t border-blush-200 bg-blush-50 p-3 md:hidden">
          <a class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" href="/customize">
            Design a bandana
          </a>
        </div>
      )
    }
  </body>
</html>
