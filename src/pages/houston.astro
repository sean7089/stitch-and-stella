---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import neighborhoods from '../data/neighborhoods.json';
import { photos } from '../lib/images';
import { breadcrumb, graph } from '../lib/schema';

const jsonLd = graph(Astro.site, [
  {
    '@type': 'Service',
    name: 'Custom dog bandanas in Houston',
    serviceType: 'Handmade dog bandana',
    areaServed: {
      '@type': 'City',
      name: 'Houston',
      sameAs: 'https://www.wikidata.org/wiki/Q16555',
    },
    provider: { '@id': new URL('/#business', Astro.site ?? 'https://www.stitchandstella.com').href },
  },
  breadcrumb(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Houston', path: '/houston' },
  ]),
]);
---

<Base
  title="Dog bandanas in Houston | Stitch & Stella"
  description="Stitch & Stella stitches cotton and linen dog bandanas in Houston and hands them off in the Heights and Garden Oaks."
  image={photos.hero}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <p class="text-sm font-semibold uppercase tracking-wide text-rose-800">Houston, Texas</p>
    <h1 class="mt-3 font-serif text-5xl leading-tight">Made in Houston. Handed off in two neighborhoods.</h1>
    <div class="mt-6 space-y-4 text-lg leading-8 text-ink-soft">
      <p>
        Stitch &amp; Stella is a dog bandana studio in Houston. The cloth is cotton or linen because the constraint is heat and humidity, not a season from somewhere colder. Halloween and Christmas bandanas use that same weight.
      </p>
      <p>
        Handoffs are specific. Saturday mornings in the Heights, 77008 and 77009. Thursday evenings in Garden Oaks, 77018. This is not a citywide delivery promise, and it is not a shop you can walk into.
      </p>
      <p>
        The Heights page is about sidewalks, Heights Boulevard, and White Oak Bayou. The Garden Oaks page is about shaded yards north of the Heights. If you live in a third neighborhood, say so on the ticket. We would rather tell you no than stretch a page to cover you.
      </p>
    </div>
  </article>
  <section class="mx-auto grid max-w-6xl gap-8 px-5 pb-16 md:grid-cols-2">
    {
      neighborhoods.map((item) => (
        <a class="rounded-3xl bg-paper p-3" href={`/neighborhoods/${item.id}`}>
          <Image
            src={item.imageKey === 'heights' ? photos.heights : photos.garden}
            alt={item.imageAlt}
            widths={[480, 800]}
            sizes="(min-width: 768px) 34rem, 100vw"
            quality={55}
            format="avif"
            loading="lazy"
            class="h-auto w-full rounded-2xl"
          />
          <h2 class="mt-4 px-2 font-serif text-3xl">{item.name}</h2>
          <p class="mt-2 px-2 pb-3 leading-7 text-ink-soft">{item.handoff.label}. ZIP {item.zips.join(' and ')}.</p>
        </a>
      ))
    }
  </section>
</Base>
