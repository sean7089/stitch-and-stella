---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import themes from '../../data/themes.json';
import { photoFor } from '../../lib/images';
import { formatMoney, priceConfiguration, resolveSelection } from '../../lib/pricing';
import { breadcrumb, graph } from '../../lib/schema';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.id },
    props: { theme },
  }));
}

interface Props {
  theme: (typeof themes)[number];
}

const { theme } = Astro.props;
const priced = priceConfiguration(resolveSelection(new URLSearchParams(`theme=${theme.id}`)));
const fabric = catalog.fabrics.find((item) => item.id === theme.preset.fabricId);
const edge = catalog.edges.find((item) => item.id === theme.preset.edgeId);
const thread = catalog.threads.find((item) => item.id === theme.preset.threadId);
const motif = catalog.motifs.find((item) => item.id === theme.preset.motifId);
const jsonLd = graph(Astro.site, [
  breadcrumb(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Themes', path: '/themes' },
    { name: theme.name, path: `/themes/${theme.id}` },
  ]),
]);
---

<Base
  title={`${theme.name} dog bandanas | Stitch & Stella`}
  description={theme.metaDescription}
  image={photoFor(theme.imageKey)}
  jsonLd={jsonLd}
>
  <article class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-rose-800">{theme.season}</p>
      <h1 class="mt-3 font-serif text-5xl leading-tight">{theme.name}</h1>
      <div class="mt-5 space-y-4 text-lg leading-8 text-ink-soft">
        {theme.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="mt-6 space-y-2 text-ink">
        <div class="flex justify-between gap-4 border-b border-blush-200 py-2"><dt>Cloth</dt><dd>{fabric?.name}</dd></div>
        <div class="flex justify-between gap-4 border-b border-blush-200 py-2"><dt>Edge</dt><dd>{edge?.name}</dd></div>
        <div class="flex justify-between gap-4 border-b border-blush-200 py-2"><dt>Thread</dt><dd>{thread?.name}</dd></div>
        <div class="flex justify-between gap-4 border-b border-blush-200 py-2"><dt>Motif</dt><dd>{motif?.name}</dd></div>
        <div class="flex justify-between gap-4 py-2"><dt>Starting total, size M</dt><dd class="font-semibold">{formatMoney(priced.totalCents)}</dd></div>
      </dl>
      <a class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" href={`/customize?theme=${theme.id}`}>
        Start with {theme.name}
      </a>
    </div>
    <Image
      src={photoFor(theme.imageKey)}
      alt={theme.imageAlt}
      widths={[480, 900]}
      sizes="(min-width: 768px) 34rem, 100vw"
      quality={60}
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full rounded-3xl"
    />
  </article>
</Base>
