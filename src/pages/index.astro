---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import business from '../data/business.json';
import catalog from '../data/catalog.json';
import faq from '../data/faq.json';
import neighborhoods from '../data/neighborhoods.json';
import themes from '../data/themes.json';
import { photoFor } from '../lib/images';
import { formatMoney, priceBounds, priceConfiguration, resolveSelection } from '../lib/pricing';
import { graph, productNode } from '../lib/schema';

const bounds = priceBounds();
const everyday = priceConfiguration(resolveSelection(new URLSearchParams()));
const featuredFaq = faq.slice(0, 4);
const jsonLd = graph(Astro.site, [productNode(Astro.site)]);
---

<Base
  title="Handmade dog bandanas in Houston | Stitch & Stella"
  description="Stitch & Stella stitches made-to-order dog bandanas in Houston. Choose the cloth and the stitch. Handoffs in the Heights and Garden Oaks."
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:grid-cols-2 md:py-20">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-rose-800">Houston · the Heights · Garden Oaks</p>
      <h1 class="mt-3 font-serif text-5xl leading-tight text-ink md:text-6xl">Dog bandanas stitched for the Heights and Garden Oaks.</h1>
      <p class="mt-5 max-w-xl text-lg leading-8 text-ink-soft">
        Stitch &amp; Stella is a Houston studio. You choose the cloth and the stitching. We hand the finished bandana off in the Heights or Garden Oaks. Most tickets start at {formatMoney(bounds.minCents)}.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" href="/customize">Design a bandana</a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-rose-800 px-5 font-semibold text-rose-800" href="/themes">Halloween and Christmas</a>
      </div>
    </div>
    <Image
      src={photoFor('hero')}
      alt="Cream dog wearing a blush linen bandana with rose blanket stitching, sitting on a pale pink bungalow porch."
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 32rem, 100vw"
      quality={58}
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full rounded-3xl"
    />
  </section>

  <section class="border-y border-blush-200 bg-blush-100" aria-label="Studio facts">
    <dl class="mx-auto grid max-w-6xl gap-6 px-5 py-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="text-sm font-semibold uppercase tracking-wide text-rose-800">Starts at</dt>
        <dd class="mt-1 font-serif text-3xl">{formatMoney(bounds.minCents)}</dd>
      </div>
      <div>
        <dt class="text-sm font-semibold uppercase tracking-wide text-rose-800">Studio time</dt>
        <dd class="mt-1 font-serif text-3xl">{catalog.leadDays} days</dd>
      </div>
      <div>
        <dt class="text-sm font-semibold uppercase tracking-wide text-rose-800">Heights</dt>
        <dd class="mt-1 text-lg">Saturday, 9–11 a.m.</dd>
      </div>
      <div>
        <dt class="text-sm font-semibold uppercase tracking-wide text-rose-800">Garden Oaks</dt>
        <dd class="mt-1 text-lg">Thursday, 5–7 p.m.</dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="font-serif text-4xl">Two choices, then a ticket</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <article class="rounded-3xl bg-paper p-6">
        <h3 class="font-serif text-2xl">The bandana</h3>
        <p class="mt-3 leading-7 text-ink-soft">Cut, cloth, and neck size. Triangle, collar slide, or kerchief. Linen and cotton only, because a Houston walk does not need a heavier layer.</p>
      </article>
      <article class="rounded-3xl bg-paper p-6">
        <h3 class="font-serif text-2xl">The stitching</h3>
        <p class="mt-3 leading-7 text-ink-soft">Edge, thread, motif, and the dog’s name. The designer adds the price as you go. An everyday size M blush triangle with blanket stitch is {formatMoney(everyday.totalCents)}.</p>
      </article>
    </div>
    <p class="mt-6 text-ink-soft">Nothing is charged on this site. {business.notIncluded[0]}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-serif text-4xl">Themes</h2>
      <a class="hidden min-h-12 items-center font-semibold text-rose-800 underline sm:inline-flex" href="/themes">All themes</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        themes.map((theme) => (
          <a class="block rounded-3xl bg-paper p-3" href={`/themes/${theme.id}`}>
            <Image
              src={photoFor(theme.imageKey)}
              alt={theme.imageAlt}
              widths={[400, 640]}
              sizes="(min-width: 768px) 22rem, 100vw"
              quality={55}
              format="avif"
              loading="lazy"
              class="h-auto w-full rounded-2xl"
            />
            <h3 class="mt-4 px-2 font-serif text-2xl">{theme.name}</h3>
            <p class="mt-2 px-2 pb-3 text-sm leading-6 text-ink-soft">{theme.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-2">
      {
        neighborhoods.map((item) => (
          <article>
            <Image
              src={photoFor(item.imageKey)}
              alt={item.imageAlt}
              widths={[480, 800]}
              sizes="(min-width: 768px) 34rem, 100vw"
              quality={55}
              format="avif"
              loading="lazy"
              class="h-auto w-full rounded-3xl"
            />
            <h2 class="mt-5 font-serif text-3xl">{item.name}</h2>
            <p class="mt-3 leading-7 text-ink-soft">{item.paragraphs[0]}</p>
            <a class="mt-4 inline-flex min-h-12 items-center font-semibold text-rose-800 underline" href={`/neighborhoods/${item.id}`}>
              Handoff in {item.name}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="font-serif text-4xl">Questions people ask first</h2>
    <div class="mt-6 divide-y divide-blush-200 border-y border-blush-200">
      {
        featuredFaq.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none py-2 font-semibold">{item.question}</summary>
            {item.answer.map((paragraph) => (
              <p class="mt-2 max-w-3xl leading-7 text-ink-soft">{paragraph}</p>
            ))}
          </details>
        ))
      }
    </div>
    <a class="mt-6 inline-flex min-h-12 items-center font-semibold text-rose-800 underline" href="/faq">All questions</a>
  </section>
</Base>
