---
import Base from '../layouts/Base.astro';
import business from '../data/business.json';
import { fulfillmentChoices, neighborhoodChoices } from '../lib/ticket';
import { breadcrumb, graph } from '../lib/schema';

const jsonLd = graph(Astro.site, [
  breadcrumb(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Stitch ticket', path: '/contact' },
  ]),
]);
const fieldClass = 'mt-2 min-h-12 w-full rounded-2xl border border-blush-300 bg-paper px-4 text-base';
---

<Base
  title="Send a stitch ticket | Stitch & Stella"
  description="Email Stitch & Stella a stitch ticket for a handmade dog bandana. Handoffs in the Heights and Garden Oaks. Nothing is charged on this page."
  jsonLd={jsonLd}
  showOrderBar={false}
>
  <section class="mx-auto max-w-3xl px-5 py-14">
    <div id="ticket-bot" hidden>
      <h1 class="font-serif text-5xl">Thanks</h1>
      <p class="mt-4 leading-7 text-ink-soft">If this was a real note, write {business.email} directly.</p>
    </div>

    <div id="ticket-ready" hidden>
      <p class="text-sm font-semibold uppercase tracking-wide text-rose-800">Ticket <span id="ticket-id"></span></p>
      <h1 class="mt-3 font-serif text-5xl leading-tight">Ready to email.</h1>
      <p class="mt-4 leading-7 text-ink-soft">
        This page does not charge a card and does not store the ticket on a server. Email it to the studio. The reply confirms the cloth, the handoff, and what is owed.
      </p>
      <p id="ticket-lead" class="mt-4 text-lg"></p>
      <a id="ticket-mail" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" href={`mailto:${business.email}`}>
        Email this to the studio
      </a>
      <pre id="ticket-body" class="mt-6 overflow-x-auto whitespace-pre-wrap rounded-3xl bg-paper p-5 text-sm leading-6"></pre>
    </div>

    <div id="ticket-form-wrap">
      <h1 id="ticket-heading" class="font-serif text-5xl leading-tight">Write the studio</h1>
      <p id="ticket-intro" class="mt-4 text-lg leading-8 text-ink-soft">
        For a bandana, <a class="font-semibold text-rose-800 underline" href="/customize">design it first</a>. Use this form for a question about a handoff or a size. Nothing is charged here.
      </p>
      <p id="ticket-alert" class="mt-4 rounded-2xl bg-blush-100 px-4 py-3 text-rose-800" hidden role="alert"></p>
      <form id="ticket-form" class="mt-8 space-y-5" method="get" action="/contact">
        <input type="hidden" name="ticket" value="1" />
        <input type="hidden" name="theme" value="" />
        <input type="hidden" name="shape" value="" />
        <input type="hidden" name="fabric" value="" />
        <input type="hidden" name="size" value="" />
        <input type="hidden" name="edge" value="" />
        <input type="hidden" name="thread" value="" />
        <input type="hidden" name="motif" value="" />
        <input type="hidden" name="monogram" value="" />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="company_website">Company website</label>
          <input id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label class="font-semibold" for="name">Your name</label>
          <input class={fieldClass} id="name" name="name" required autocomplete="name" />
        </div>
        <div>
          <label class="font-semibold" for="email">Email</label>
          <input class={fieldClass} id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label class="font-semibold" for="dog">Dog’s name</label>
          <input class={fieldClass} id="dog" name="dog" autocomplete="off" />
        </div>
        <div>
          <label class="font-semibold" for="neighborhood">Neighborhood</label>
          <select class={fieldClass} id="neighborhood" name="neighborhood" required>
            <option value="">Choose one</option>
            {neighborhoodChoices.map((item) => <option value={item.id}>{item.label}</option>)}
          </select>
        </div>
        <div>
          <label class="font-semibold" for="fulfillment">Handoff</label>
          <select class={fieldClass} id="fulfillment" name="fulfillment" required>
            <option value="">Choose one</option>
            {fulfillmentChoices.map((item) => <option value={item.id}>{item.label}</option>)}
          </select>
        </div>
        <div>
          <label class="font-semibold" for="note">Note</label>
          <textarea class={`${fieldClass} min-h-32 py-3`} id="note" name="note" maxlength="280"></textarea>
        </div>
        <button class="inline-flex min-h-12 items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" type="submit">
          Create the stitch ticket
        </button>
      </form>
    </div>
  </section>
</Base>

<script>
  import { initTicket } from '../scripts/ticket-page';
  initTicket();
</script>
