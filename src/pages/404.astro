---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Stitch & Stella" description="That page is not on the Stitch & Stella site." noindex={true}>
  <section class="mx-auto max-w-3xl px-5 py-20">
    <h1 class="font-serif text-5xl">That page is not here.</h1>
    <p class="mt-4 text-lg leading-8 text-ink-soft">The bandana designer is still available.</p>
    <a class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-rose-800 px-5 font-semibold text-white" href="/customize">Design a bandana</a>
  </section>
</Base>
